{
  "name": "@local/dsh-thai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Native Thai language pack for DeepSeek Harness 0.2.2-rc.3",
  "license": "MIT AND Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/FILM6912/dsh-ui-thai.git" },
  "homepage": "https://github.com/FILM6912/dsh-ui-thai#readme",
  "bugs": { "url": "https://github.com/FILM6912/dsh-ui-thai/issues" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE", "NOTICE", "licenses"],
  "engines": { "dsh": "0.2.2-rc.3" },
  "scripts": { "build": "node tools/build.mjs", "test": "node --test tests/pack.test.mjs", "check": "node tools/build.mjs --check" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-locale"] }
  }
}
