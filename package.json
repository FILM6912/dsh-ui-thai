{
  "name": "dsh-ui-thai",
  "version": "1.2.0",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "keywords": ["dsh-plugin", "deepseek-harness", "thai", "th", "i18n", "locale", "language-pack"],
  "type": "module",
  "description": "Thai language pack with integrated voice input for DeepSeek Harness 0.2.2-rc.3",
  "license": "MIT AND Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/FILM6912/dsh-ui-thai.git" },
  "homepage": "https://github.com/FILM6912/dsh-ui-thai#readme",
  "bugs": { "url": "https://github.com/FILM6912/dsh-ui-thai/issues" },
  "exports": { ".": "./index.js", "./client": "./bundle-client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg", "./package.json": "./package.json" },
  "files": ["index.js", "voice-settings-adapter.js", "client.js", "bundle-client.js", "vendor/dsh-voice", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "CHANGELOG.md", "PUBLISHING.md", "PLUGIN-HUB.md", "LICENSE", "NOTICE", "licenses", "compat"],
  "engines": { "dsh": "0.2.2-rc.3" },
  "scripts": {
    "build": "node tools/build.mjs && node tools/build-voice.mjs",
    "vendor:voice": "node tools/vendor-voice.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/build.mjs --check && node tools/build-voice.mjs --check",
    "prepublishOnly": "npm test && npm run check && node --check bundle-client.js && node --check index.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-ui-settings"] }
  }
}
