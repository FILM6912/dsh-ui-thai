@@ -0,0 +1,41 @@
+import type { CatalogLocaleId, LocaleId, LocaleService } from '../types.ts'
+
+export const LOCALE_NAMESPACE = 'dsh-plugin'
+
+/** UI support is independent of the catalog's two-language API. */
+export function uiLocaleOf(active: string): LocaleId {
+  return active === 'th' || active === 'zh' ? active : 'en'
+}
+
+export function catalogLocaleOf(active: string): CatalogLocaleId {
+  return active === 'zh' ? 'zh' : 'en'
+}
+
+/** Keep Gregorian years consistent with the Hub's version/log timestamps. */
+export function dateLocaleOf(active: string): string {
+  return active === 'th' ? 'th-TH-u-ca-gregory' : active === 'zh' ? 'zh-CN' : 'en-US'
+}
+
+/** Only offer languages installed in the host; registering strings does not add a language. */
+export function nextLanguageOf(snapshot: ReturnType<LocaleService['getSnapshot']>): { id: LocaleId; label: string } | null {
+  const order: LocaleId[] = ['en', 'zh', 'th']
+  const available = order.flatMap(id => {
+    const language = snapshot.locales.find(language => language.id === id)
+    return language ? [{ id, label: language.label }] : []
+  })
+  const current = available.findIndex(language => language.id === snapshot.active)
+  const next = available[(current + 1) % available.length]
+  return next && next.id !== snapshot.active ? next : null
+}
+
+/** Remote editorial text stays unchanged; Thai prefers th, then en, then zh. */
+export function localizedText(value: string | Record<string, string> | null | undefined, active: string): string {
+  if (typeof value === 'string') return value
+  if (!value || typeof value !== 'object') return ''
+  const languages = active === 'th' ? ['th', 'en', 'zh'] : active === 'zh' ? ['zh', 'en'] : ['en', 'zh']
+  for (const language of languages) {
+    const text = value[language]
+    if (typeof text === 'string' && text.trim()) return text
+  }
+  return ''
+}
